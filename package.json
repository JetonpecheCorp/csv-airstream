{
  "name": "@jetonpeche/csv-airstream",
  "version": "1.5.0",
  "type": "module",
  "author": "jetonpeche",
  "description": "Zero-dependency, memory-safe CSV streaming parser & writer using Web Streams. Features TypeScript DTO decorators and a resilient Result pattern.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "csv",
    "csv-parser",
    "csv-writer",
    "csv-stream",
    "streaming",
    "web-streams",
    "typescript",
    "decorators",
    "dto",
    "isomorphic",
    "zero-dependency",
    "edge",
    "deno",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jetonpecheCorp/csv-airstream.git"
  },
  "readme": "https://github.com/jetonpecheCorp/csv-airstream#readme",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}